RewriteEngine On

RewriteCond %{HTTP_HOST} ^oree-restaurant\.com$ [NC]
RewriteRule ^ https://www.oree-restaurant.com%{REQUEST_URI} [R=301,L]

# Fichiers internes : jamais accessibles en HTTP
RedirectMatch 403 ^/(secret\.ini|inc/|\.git|package(-lock)?\.json|webpack\.config\.js)

# data/ is private (users, rate limiting, invitations), except the published menu
RewriteRule ^data/(?!carte/menu_oree\.pdf$) - [F,L]
